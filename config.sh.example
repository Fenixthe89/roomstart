# Esempio: copia in ${XDG_CONFIG_HOME:-$HOME/.config}/roomstart/config.sh
# oppure usa ./install.sh. Questo file di esempio non viene letto direttamente.
# La configurazione personale e' Bash locale: usa solo contenuti fidati.
# I metadati delle singole room, invece, sono file di testo.

# Cartella delle room. Mantieni lo stesso percorso per ritrovare quelle esistenti.
ROOMSTART_BASE="$HOME/Rooms"

# Percorso personalizzato a newroom; vuoto usa quello incluso nel progetto.
# install.sh mantiene questo valore durante gli aggiornamenti.
ROOMSTART_NEWROOM=""

# Porta usata per nuove room; una room esistente conserva la propria porta.
# Intervallo valido: 1-65535. Puoi cambiarla con roomstart NomeRoom --port 4445.
ROOMSTART_LISTENER_PORT=4444

# Layout delle finestre separate. Richiede X11, wmctrl, xdotool, xprop.
# Adatta le coordinate ai tuoi monitor prima di abilitare il posizionamento.
# X/Y ammettono valori negativi; W/H devono essere positive.
ROOMSTART_LAYOUT_ENABLED=false

ROOMSTART_FIREFOX_X=800
ROOMSTART_FIREFOX_Y=0
ROOMSTART_FIREFOX_W=1400
ROOMSTART_FIREFOX_H=1315

ROOMSTART_NOTES_X=2177
ROOMSTART_NOTES_Y=0
ROOMSTART_NOTES_W=372
ROOMSTART_NOTES_H=1243

ROOMSTART_LISTENER_X=10
ROOMSTART_LISTENER_Y=1059
ROOMSTART_LISTENER_W=813
ROOMSTART_LISTENER_H=282

ROOMSTART_MAIN_X=10
ROOMSTART_MAIN_Y=97
ROOMSTART_MAIN_W=812
ROOMSTART_MAIN_H=988
