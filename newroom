#!/bin/bash
# ============================================================
# Script: newroom
# Autore: Fenix89
# Scopo: creare automaticamente la struttura di una nuova room
# ============================================================

# Resolve the executable itself, including ~/.local/bin symlink installs.
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")" || exit 1
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)" || exit 1

# shellcheck source=lib/state.sh
source "$SCRIPT_DIR/lib/state.sh" || exit 1

if [ -f "$SCRIPT_DIR/lib/config.sh" ]; then
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/lib/config.sh" || exit 1
else
    : "${ROOMSTART_BASE:=$HOME/Rooms}"
    : "${ROOMSTART_LISTENER_PORT:=4444}"
fi

BASE="$ROOMSTART_BASE"
ROOM="${1:-}"

if [ "$#" -ne 1 ] || [ -z "$ROOM" ]; then
    echo "Uso: newroom NomeRoom"
    exit 1
fi

if ! rs_validate_name "$ROOM"; then
    echo "Errore: nome room non valido (niente separatori, controlli o prefissi '.'/'-')." >&2
    exit 1
fi

ROOMDIR=$(rs_room_path "$BASE" "$ROOM") || exit 1
rs_validate_port "$ROOMSTART_LISTENER_PORT" || { rs_error 'Porta listener non valida.'; exit 1; }

mkdir -p -- "$ROOMDIR" || exit 1
# Existing links/files are preserved, but are not used for new writes.
for entry in scans loot exploit screenshots; do
    if [[ -L "$ROOMDIR/$entry" || ( -e "$ROOMDIR/$entry" && ! -d "$ROOMDIR/$entry" ) ]]; then
        rs_error "Cartella della room non sicura: $entry"
        exit 1
    fi
done
mkdir -p -- "$ROOMDIR"/{scans,loot,exploit,screenshots} || {
    echo "Errore: impossibile creare le cartelle in $ROOMDIR"
    exit 1
}

# Reopening a room never replaces notes or a report. Noclobber also covers
# another process creating notes between this check and opening the file.
if [[ ! -e "$ROOMDIR/notes.md" && ! -L "$ROOMDIR/notes.md" ]]; then
if ! (set -o noclobber; cat > "$ROOMDIR/notes.md" << EOF
# $ROOM

## Target
IP:

## Appunti e risultati

Appunti rapidi: [appunti.md](appunti.md)

## Credenziali e flag

## Prossimo passo

EOF
); then
    rs_error 'Impossibile creare notes.md; nessun file esistente viene sovrascritto.'
    exit 1
fi
fi

if [[ ! -e "$ROOMDIR/report.md" && ! -L "$ROOMDIR/report.md" ]]; then
    (set -o noclobber; : > "$ROOMDIR/report.md") || exit 1
fi
rs_state_init "$ROOMDIR" "$ROOMSTART_LISTENER_PORT" || exit 1
echo "Room pronta in: $ROOMDIR"

# Il cd vale solo per questo processo: se lo lanci direttamente
# (./newroom NomeRoom) non sposta la tua shell. Ci pensa roomstart.
cd "$ROOMDIR" || exit 1
